# ============================================================
# TANKECH PRO — Environment Variables
# Copy this file to `.env.local` and fill in your credentials.
# Never commit `.env.local` to Git!
# ============================================================

# ---- Firebase Client SDK (for /admin login) ----
# Find these in Firebase Console -> Project Settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---- Firebase Admin SDK (server-side API routes & Firestore) ----
# Generate in Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the private_key from the JSON file (keep \n escaped inside double quotes)
FIREBASE_PRIVATE_KEY=""

# ---- Admin Authorization ----
# Comma-separated list of Firebase Auth emails allowed to access /admin
ADMIN_EMAILS="said.elbaghdadi16@gmail.com"

# ---- Gmail SMTP (Nodemailer) ----
# Create a Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER="said.elbaghdadi16@gmail.com"
GMAIL_APP_PASSWORD=""
# Where quote notifications should be sent (defaults to GMAIL_USER)
QUOTE_NOTIFICATION_EMAIL="said.elbaghdadi16@gmail.com"
